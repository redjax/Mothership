{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "enabledManagers": [
        "pep621",
        "github-actions"
    ],
    "ignorePaths": [
        "submodules/**",
        "**/.gitmodules"
    ],
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchManagers": [
                "pep621"
            ],
            "matchFileNames": [
                "scripts/updater/**"
            ],
            "rangeStrategy": "bump"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "matchFileNames": [
                ".github/workflows/**"
            ]
        },
        {
            "description": "Automatically merge patch and minor updates",
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "description": "Require manual review for major updates",
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false
        }
    ]
}